{
  "name": "quest-timer",
  "version": "1.0.0",
  "description": "퀘스트를 깨듯 공부하는 집중 타이머",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "shot": "electron scripts/shot.js",
    "test": "node --test",
    "smoke": "electron scripts/smoke.js",
    "icon": "electron scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Quest Timer",
  "build": {
    "appId": "com.questtimer.app",
    "productName": "Quest Timer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quest Timer",
      "artifactName": "Quest Timer Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "Quest Timer ${version} portable.exe"
    }
  }
}
